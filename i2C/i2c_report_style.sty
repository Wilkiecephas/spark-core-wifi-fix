    boxrule=0.8pt,
    arc=2mm,
    before skip=8pt,
    after skip=8pt,
    #1
}

\newtcolorbox{troublebox}[1][]{
    enhanced,
    colback=AlertRed!5!white,
    colframe=AlertRed,
    fonttitle=\bfseries\color{white},
