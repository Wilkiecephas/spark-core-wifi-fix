\newtcolorbox{objectivebox}[1][]{
    enhanced,
    colback=LightBg,
    colframe=KyuNavy,
    fonttitle=\bfseries\color{white},
    coltitle=white,
    title={\textbf{OBJECTIVE \& LAB FOCUS}},
    boxrule=0.8pt,
    arc=2mm,
    drop shadow=black!10,
    before skip=8pt,
    after skip=8pt,
    #1
}

\newtcolorbox{theorybox}[1][]{
    enhanced,
    colback=white,
    colframe=KyuGold!90!black,
    fonttitle=\bfseries\color{black},
    coltitle=black,
